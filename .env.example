# Copy this to apps/web/.env.local for local dev, or set these in your Vercel project.
# See DEPLOYMENT.md for exactly where each value comes from.

# Persistence — without this, the app falls back to an in-memory dev database
# (data does not persist across restarts; refused outright in production).
DATABASE_URL=

# Real auth (Supabase magic link). Without these, a dev-only stand-in login is used
# instead — hard-disabled whenever NODE_ENV=production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider. Without this, every AI feature reports AI_PROVIDER_NOT_CONFIGURED
# instead of failing or fabricating a response.
OPENAI_API_KEY=

# Real Web Push notifications (survive a closed tab). Generate once with
# `node -e "console.log(require('web-push').generateVAPIDKeys())"` — no external
# account needed, it's just a keypair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google Calendar / Gmail (read-only) integration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Any random 32+ character secret you generate once, used to encrypt stored OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=

# "Find opportunities" web search. Optional — without it, that feature reports
# WEB_RESEARCH_NOT_CONFIGURED instead of failing.
SERPAPI_KEY=
